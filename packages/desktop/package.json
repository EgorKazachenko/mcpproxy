  },
  "dependencies": {
    "@mcpproxy/contracts": "workspace:*",
    "@mcpproxy/design": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43",
    "electron-vite": "^5",
    "es-module-lexer": "^2.3.2",
    "vite": "7.3.6",
    "vitest": "^3"
  },
  "main": "out/main/index.js"
}
