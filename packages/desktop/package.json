{
  "name": "@mcpproxy/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "out",
    "fixtures"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
