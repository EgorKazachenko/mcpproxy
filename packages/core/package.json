{
  "name": "@mcpproxy/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/policy/pure.d.ts",
      "default": "./dist/policy/pure.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "tsc -b && vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mcpproxy/contracts": "workspace:*"
  },
  "devDependencies": {
    "es-module-lexer": "^2.3.2",
    "vitest": "^3"
  },
  "bin": {
    "mcpproxy-lock": "./bin/mcpproxy-lock.mjs"
  }
}
