{
  "name": "@mcpproxy/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/exec/policy.d.ts",
      "default": "./dist/exec/policy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "tsc -b && vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "vitest": "^3"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.74",
    "@mcpproxy/contracts": "workspace:*"
  }
}
