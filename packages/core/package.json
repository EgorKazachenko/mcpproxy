{
  "name": "@mcpproxy/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "tsc -b && vitest run",
    "update:api-surface": "tsc -b && node scripts/update-api-surface.mjs"
  },
  "dependencies": {
    "@mcpproxy/contracts": "workspace:*",
    "re2": "1.26.1"
  },
  "devDependencies": {
    "es-module-lexer": "^2.3.2",
    "vitest": "^3"
  }
}
