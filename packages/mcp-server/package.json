{
  "name": "@mcpproxy/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "tsc -b && vitest run"
  },
  "dependencies": {
    "@mcpproxy/contracts": "workspace:*",
    "@mcpproxy/core": "workspace:*"
  },
  "bin": {
    "mcpproxy-shim": "./bin/mcpproxy-shim.mjs",
    "mcpproxyd": "./bin/mcpproxyd.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^3"
  }
}
