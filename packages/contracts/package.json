{
  "name": "@mcpproxy/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/mcpproxy.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "tsc -b && vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "15.0.4",
    "vitest": "^3"
  }
}
